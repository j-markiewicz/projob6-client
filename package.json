{
	"name": "projob6",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"lint": "eslint .",
		"fmt-check": "prettier -c .",
		"lint-file": "eslint",
		"fmt-check-file": "prettier -c",
		"preview": "vite preview",
		"prepare": "husky",
		"precommit": "lint-staged"
	},
	"dependencies": {
		"prop-types": "^15.8.1",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"react-router": "^7.14.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"eslint": "^9.39.4",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.5.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.5",
		"prettier": "^3.8.3",
		"vite": "^8.0.9"
	},
	"prettier": {
		"trailingComma": "es5",
		"tabWidth": 4,
		"useTabs": true,
		"semi": true,
		"singleQuote": false
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"npm run lint-file",
			"npm run fmt-check-file"
		],
		"*.{json,md,mdx,css,scss,html,yml,yaml}": "npm run fmt-check-file"
	}
}
